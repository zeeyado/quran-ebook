{% import "_parts.j2" as parts -%}
<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="ar" lang="ar" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <title>سورة {{ surah.name_arabic }}</title>
    <link rel="stylesheet" type="text/css" href="styles/base.css"/>
</head>
<body>
{%- if surah.ayahs and surah.ayahs[0].page_marker %}
    {{ parts.page_marker(surah.ayahs[0]) }}
{%- endif %}
    {{ parts.surah_head(surah, bismillah_text) }}
    <div class="surah-text">
{%- for ayah in surah.ayahs %}{% if not loop.first %}{{ parts.page_marker(ayah) }}{% endif %}{{ parts.hizb(ayah, flow=true) }}{{ parts.ayah_text(surah, ayah, note_href=('endnotes.xhtml#trans-' ~ surah.number ~ '-' ~ ayah.ayah_number) if ayah.translation else '', flow=true, bare_note_mark=true) }}{% endfor %}</div>
</body>
</html>
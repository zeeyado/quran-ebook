{% import "_parts.j2" as parts -%}
<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="ar" lang="ar" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <title>سورة {{ surah.name_arabic }}</title>
    <link rel="stylesheet" type="text/css" href="styles/base.css"/>
</head>
<body>
{#- In flowing text every page marker stands inside the surah's block, the
    first ayah's too (in the other layouts that one stands before the head).
    The block is one run of text and spans, and a reading app stores a place
    in it by counting the spans; a marker taken out of the block would shift
    every saved place of that surah by one. #}
    {{ parts.surah_head(surah, bismillah_text, plain=true) }}
    <div class="surah-text">
{%- for ayah in surah.ayahs %}{{ parts.page_marker(ayah) }}{{ parts.hizb(ayah, flow=true) }}{{ parts.ayah_text(surah, ayah, flow=true) }}{% endfor %}</div>
</body>
</html>
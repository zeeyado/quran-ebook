<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="ar" lang="ar" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <title>{{ title }}</title>
    <style>
{%- if font_family and font_filename %}
        @font-face {
            font-family: '{{ font_family }}';
            src: url('fonts/{{ font_filename }}') format('truetype');
        }
{%- endif %}
{%- if cover_font_family and cover_font_filename %}
        @font-face {
            font-family: '{{ cover_font_family }}';
            src: url('fonts/{{ cover_font_filename }}') format('truetype');
        }
{%- endif %}
{%- if symbol_font_family and symbol_font_filename %}
        @font-face {
            font-family: '{{ symbol_font_family }}';
            src: url('fonts/{{ symbol_font_filename }}') format('truetype');
        }
{%- endif %}
        /* The title page: plain blocks, each with its own size counted in
           the reader's text size (no table: reading apps size a table each
           in their own way, and one stretches it over the page). The sizes
           are the ones KOReader has drawn all along. */
        html, body {
            margin: 0;
            padding: 0;
{%- if font_family %}
            font-family: '{{ font_family }}', serif;
{%- endif %}
        }
        /* 3px: KOReader gives every table that margin, and this page was a
           table; kept so that the page sits where it always sat there. */
        .cover-wrap {
            margin: 3px 0;
        }
        .cover-main {
            text-align: center;
            padding: 4.8em 0.8em 0 0.8em;
        }
        .cover-title {
{%- if cover_font_family %}
            font-family: '{{ cover_font_family }}', serif;
{%- endif %}
            font-size: 6.405em;
            line-height: 1.2;
            text-align: center;
            text-indent: 0;
            margin: 0;
            padding: 0;
        }
        .cover-subtitle {
{%- if symbol_font_family %}
            font-family: '{{ symbol_font_family }}', serif;
{%- endif %}
            font-size: 1.12em;
            color: #444;
            text-align: center;
            text-indent: 0;
            margin: 0;
            padding: 2em 0 0 0;
        }
        .cover-layout-desc {
{%- if symbol_font_family %}
            font-family: '{{ symbol_font_family }}', serif;
{%- endif %}
            font-size: 0.8em;
            color: #888;
            text-align: center;
            text-indent: 0;
            margin: 0;
            padding: 0.05em 0;
        }
        .cover-translation-label {
            font-family: serif;
            font-size: 0.68em;
            color: #555;
            text-align: center;
            text-indent: 0;
            margin: 0;
            padding: 0.05em 0;
        }
        .cover-version-box {
            padding: 3.205em 0.8em 0.8em 0.8em;
        }
        .cover-version {
            font-family: monospace;
            font-size: 0.48em;
            color: #bbb;
            text-align: left;
            text-indent: 0;
            margin: 0;
            padding: 0;
        }
    </style>
</head>
<body>
    <div class="cover-wrap">
        <div class="cover-main">
            <p class="cover-title">&#xE076;</p>
{%- if subtitle %}
            <p class="cover-subtitle">{{ subtitle }}</p>
{%- endif %}
{%- if layout_descriptor %}
            <p class="cover-layout-desc">{{ layout_descriptor }}</p>
{%- endif %}
{%- if translation_label %}
            <p class="cover-translation-label">{{ translation_label }}</p>
{%- endif %}
        </div>
{%- if version %}
        <div class="cover-version-box">
            <p class="cover-version" dir="ltr">{{ version }}</p>
        </div>
{%- endif %}
    </div>
</body>
</html>

{% import "_parts.j2" as parts -%}
<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="ar" lang="ar" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <title>سورة {{ surah.name_arabic }}</title>
    <link rel="stylesheet" type="text/css" href="styles/base.css"/>
</head>
<body>
    {{ parts.surah_head(surah, bismillah_text) }}
    <div class="surah-text qcf-text">
{%- for ayah in surah.ayahs %}{% if ayah.page_marker %}<span epub:type="pagebreak" role="doc-pagebreak" id="page{{ ayah.page_marker }}" title="{{ ayah.page_marker }}"></span>{% endif %}{% if ayah.hizb_marker %}&#8288;<span class="hizb-marker">۞</span>&#8288;{% elif not loop.first %}&#x200B;{% endif %}{% for word in ayah.words %}{% if word.char_type == 'end' %}&#8288;<a class="ayah-noteref" epub:type="noteref" href="endnotes.xhtml#trans-{{ surah.number }}-{{ ayah.ayah_number }}"><span class="qcf-word qcf-end qcf-p{{ word.page_number }}" id="ayah-{{ surah.number }}-{{ ayah.ayah_number }}">{{ word.code_v2 }}</span></a>{% else %}{% if not loop.first %} {% endif %}<span class="qcf-word qcf-p{{ word.page_number }}" data-uthmani="{{ word.text }}">{{ word.code_v2 }}</span>{% endif %}{% endfor %}{% endfor %}</div>
</body>
</html>

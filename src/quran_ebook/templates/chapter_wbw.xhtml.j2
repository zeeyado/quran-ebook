{% import "_parts.j2" as parts -%}
{#- A word meaning that the source gives in another language than the book's
    word meanings (the English stand-in for a gap in the language's own
    list) says so in the page: its own lang and dir on the same span, and
    the class wbw-gloss-other, which sets it in italics. No element is
    added, so a place saved in the book reads back as before. -#}
<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="ar" lang="ar" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <title>سورة {{ surah.name_arabic }} — {{ surah.name_transliteration }}</title>
    <link rel="stylesheet" type="text/css" href="styles/base.css"/>
</head>
<body>
{%- if surah.ayahs and surah.ayahs[0].page_marker %}
    {{ parts.page_marker(surah.ayahs[0]) }}
{%- endif %}
    {{ parts.surah_head(surah, bismillah_text, latin=true) }}
{%- for ayah in surah.ayahs %}
{%- set note_href = ('endnotes.xhtml#tafsir-' ~ surah.number ~ '-' ~ (ayah.tafsir_group_start or ayah.ayah_number)) if ayah.tafsir else (('endnotes.xhtml#trans-' ~ surah.number ~ '-' ~ ayah.ayah_number) if (translation_popup and ayah.translation) else '') %}
{%- if not loop.first %}{{- parts.page_marker(ayah) }}{% endif %}
    <div class="wbw-ayah{% if not show_translation or not ayah.translation %} standalone{% endif %}" id="ayah-{{ surah.number }}-{{ ayah.ayah_number }}">
{{- parts.hizb_box(ayah) }}
{%- for word in ayah.words %}
        <span class="wbw-word"><span class="wbw-arabic">{{ word.text }}</span><span class="wbw-gloss{% if word.translation_lang %} wbw-gloss-other{% endif %}" lang="{{ word.translation_lang or wbw_gloss_lang }}" dir="{{ word.translation_dir or wbw_gloss_dir }}">{{ word.translation }}</span>
{%- if show_transliteration %}<span class="wbw-translit" dir="ltr">{{ word.transliteration }}</span>{%- endif %}
</span>
{%- endfor %}{{ parts.ayah_mark_box(surah, ayah, note_href) }}
    </div>
{%- if show_translation and ayah.translation %}
    <p class="translation" lang="{{ translation_lang }}" dir="{{ translation_dir }}"><span class="ayah-ref">{{ surah.number }}:{{ ayah.ayah_number }}</span> {{ ayah.translation }}</p>
{%- endif %}
{%- endfor %}
</body>
</html>
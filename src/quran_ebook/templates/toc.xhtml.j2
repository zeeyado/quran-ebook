<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="ar" lang="ar" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <title>الفهرس</title>
    <link rel="stylesheet" type="text/css" href="styles/base.css"/>
    <style>
        /* The contents page: no tables. A row is one line: its links are
           inline blocks of equal width with no white space between them, so
           a row cannot be cut between two pages and the cells' tops line up.
           Sizes in rem (the reader's base size).
           No child combinator: one reading app escapes it in a page's own
           style block, and the rule is lost there. */
        .toc-juz, .toc-surahs { margin: 0; padding: 0; text-indent: 0; text-align: center; font-size: 0.5rem; line-height: 1; }
        /* The older property LAST: two reading apps turn it into a column
           break for their own paging; written first, 'break-before: page'
           after it would win and one of them would not break. */
        .toc-surahs { break-before: page; page-break-before: always; }
        .toc-row { margin: 0; padding: 0; text-indent: 0; text-align: center; }
        .toc-row a { display: inline-block; vertical-align: top; margin: 0; padding: 0.3em 0; text-indent: 0; text-decoration: none; color: #1a1a1a; font-family: '{{ symbol_font_family }}', serif; font-size: 1.15rem; line-height: 1.5; }
{%- if juz_named %}
        /* A juz: its number and its name (the first words of the part in
           this book's text) on one line, three to a row. The link carries
           the Quran font, its size and line (the row is as tall as before),
           the number its own font (plain-num); the name a smaller size per
           Quran font, so that the widest name keeps its line on a page 320
           points wide. A link that starts with a bare number: KOReader
           would take it for a note. */
        .toc-juz .toc-row a { width: 33.3%; font-family: '{{ quran_font_family }}', serif; -cr-hint: noteref-ignore; }
        .toc-juz-name { font-size: {{ juz_name_size }}; }
{%- else %}
        /* A link whose text is a bare number: KOReader would take it for a note */
        .toc-juz .toc-row a { width: 16.66%; -cr-hint: noteref-ignore; }
{%- endif %}
        .toc-surahs .toc-row a { width: 33.3%; }
        /* The heading stands off from its rows: the room under it is larger
           than the room between two rows (with 0.2em it was smaller, and
           the heading read as a row of the table). */
        .toc-head { margin: 0; padding: 0 0 1em 0; text-indent: 0; text-align: center; font-family: '{{ symbol_font_family }}', serif; font-size: 1.15rem; line-height: 1.5; color: #1a1a1a; }
        .toc-ar, .toc-en { display: block; }
        .toc-num { font-size: 0.85em; color: #888; }
        .toc-en { font-family: serif; font-size: 0.8em; line-height: 1.4; color: #666; }
        nav ol { list-style-type: none; padding: 0; margin: 0; }
        nav ol li { margin: 0.3em 0; }
        nav ol li a { text-decoration: none; color: #1a1a1a; }
    </style>
</head>
<body>
{%- if juz_entries %}
    <div class="toc-juz" id="juz">
        <div class="toc-head">الأجزاء</div>
{%- if juz_named %}
{%- for row in juz_entries | batch(3) %}
        <div class="toc-row">{% for juz in row %}<a href="{{ juz.href }}"><span class="plain-num">{{ juz.label_num }}</span> <span class="toc-juz-name">{{ juz.name }}</span></a>{% endfor %}</div>
{%- endfor %}
{%- else %}
{%- for row in juz_entries | batch(6) %}
        <div class="toc-row">{% for juz in row %}<a href="{{ juz.href }}"><span class="plain-num">{{ juz.label_num }}</span></a>{% endfor %}</div>
{%- endfor %}
{%- endif %}
    </div>
{%- endif %}
    <div class="toc-surahs">
{%- for row in surahs | batch(3) %}
        <div class="toc-row">{% for surah in row %}<a href="{{ chapter_href(surah.number) }}"><span class="toc-ar"><span class="toc-num plain-num">{{ surah.number | arabic_numerals }}</span> سورة {{ surah.name_arabic }}</span>{% if is_bilingual %}<span class="toc-en" dir="ltr">{{ surah.number }}. {{ surah.name_transliteration }}</span>{% endif %}</a>{% endfor %}</div>
{%- endfor %}
    </div>
    {#- The contents list a reading app shows: the title page, the juz page
        above (one entry, named by its place on this page: an entry that
        points at a page with no place named is dead in one reading app),
        then the surahs in reading order, then the notes. The juz starts are
        on the juz page, not in this list: as entries they would stand out
        of reading order, and a reader would name a juz where a surah is meant. #}
    <nav epub:type="toc" id="toc" hidden="hidden">
        <ol>
            <li><a href="cover.xhtml">القرآن الكريم</a></li>
{%- if juz_entries %}
            <li><a href="toc.xhtml#juz">الأجزاء</a></li>
{%- endif %}
{%- for surah in surahs %}
{%- if is_bilingual %}
            <li><a href="{{ chapter_href(surah.number) }}">{{ surah.number }}. {{ surah.name_transliteration }} — سورة {{ surah.name_arabic }}</a></li>
{%- else %}
            <li><a href="{{ chapter_href(surah.number) }}">{{ surah.number | arabic_numerals }} سورة {{ surah.name_arabic }}</a></li>
{%- endif %}
{%- endfor %}
{%- if endnotes_label %}
            <li><a href="endnotes.xhtml">{{ endnotes_label }}</a></li>
{%- endif %}
        </ol>
    </nav>
{%- if page_list %}
    <nav epub:type="page-list" hidden="hidden">
        <ol>
{%- for page in page_list %}
            <li><a href="{{ page.href }}">{{ page.label }}</a></li>
{%- endfor %}
        </ol>
    </nav>
{%- endif %}
</body>
</html>

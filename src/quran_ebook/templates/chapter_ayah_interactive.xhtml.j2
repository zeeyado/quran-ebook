{% import "_parts.j2" as parts -%}
<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="ar" lang="ar" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <title>سورة {{ surah.name_arabic }}</title>
    <link rel="stylesheet" type="text/css" href="styles/base.css"/>
</head>
<body>
    {{ parts.surah_header(surah) }}
{{- parts.basmala(surah, bismillah_text) }}
{%- for ayah in surah.ayahs %}
{{- parts.page_marker(ayah) }}
    <p class="ayah-text standalone" id="ayah-{{ surah.number }}-{{ ayah.ayah_number }}">{{ parts.hizb(ayah) }}{{ ayah.text }}{{ parts.ayah_mark(surah, ayah, note_href=('endnotes.xhtml#trans-' ~ surah.number ~ '-' ~ ayah.ayah_number) if ayah.translation else '') }}</p>
{%- endfor %}
</body>
</html>